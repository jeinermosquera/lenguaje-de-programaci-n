# ===== APOMAT / SELVA SENSORIAL — variables de entorno =====
# Copia este archivo como ".env" para desarrollo local.
# En PythonAnywhere se definen en: Web tab > "Environment variables" (sin necesidad de .env).

# --- Seguridad ---
# Genera una clave fuerte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplaza_por_una_clave_secreta_aleatoria

# --- Stripe ---
# Keys de test (sk_test_...) mientras desarrollas; en producción cambia a sk_live_...
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# --- Base de datos MySQL ---
# Local (XAMPP): defaults sin variable; la app usa estos valores si faltan.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=jeiner_db
