# Copia este archivo a .env y completa los valores
# SECRET_KEY: genera una fuerte, ej: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=clave_super_secreta
# Claves Stripe (modo test por defecto)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Motor de base de datos: sqlite (default, archivo local sin servidor, ideal para PythonAnywhere)
# Para despliegues con MySQL se mantiene soportado: DB_ENGINE=mysql
DB_ENGINE=sqlite
# Archivo SQLite (relativo al directorio del proyecto); se crea solo al primer arranque
DB_PATH=site.db
# MySQL (solo si DB_ENGINE=mysql; defaults locales XAMPP)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=jeiner_db
# Servidor (producción: FLASK_DEBUG=false, FLASK_HOST=0.0.0.0)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
