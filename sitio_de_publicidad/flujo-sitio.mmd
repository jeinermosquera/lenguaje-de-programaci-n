flowchart TD
    %% ===== ESTILOS =====
    classDef page fill:#F5F1EB,stroke:#D9CFC0,stroke-width:2px,color:#2C2925
    classDef action fill:#C49B4A,stroke:#8A6412,stroke-width:2px,color:#FFFFFF
    classDef decision fill:#E8E3DA,stroke:#C49B4A,stroke-width:2px,color:#2C2925
    classDef api fill:#2C2925,stroke:#C49B4A,stroke-width:2px,color:#FFFFFF
    classDef admin fill:#8A6412,stroke:#5A4208,stroke-width:2px,color:#FFFFFF
    classDef db fill:#D9CFC0,stroke:#A89680,stroke-width:1px,color:#2C2925,stroke-dasharray: 5 5

    %% ===== ENTRADA =====
    START(["Usuario entra al sitio"]) --> HOME

    %% ===== PÁGINAS PÚBLICAS =====
    HOME[/"Home / index.html"/]:::page
    PRODUCTOS[/"Productos / productos.html + fetch /api/productos"/]:::page
    PRODUCTO_DETALLE[/"Detalle Producto / producto.html?id=X + fetch /api/producto/X"/]:::page
    LOGIN[/"Login/Registro / login/index.html"/]:::page
    CONTACTO[/"Contacto / sección en index.html"/]:::page

    HOME --> PRODUCTOS
    HOME --> LOGIN
    HOME --> CONTACTO
    PRODUCTOS --> PRODUCTO_DETALLE
    PRODUCTO_DETALLE --> CARRITO_ADD

    %% ===== FLUJO AUTH =====
    LOGIN --> REGISTRO{"¿Nuevo usuario?"}
    REGISTRO -->|Sí| REG_FORM["Registro: nombre, email, pass, confirm_pass"]:::action
    REGISTRO -->|No| LOGIN_FORM["Login: email, password"]:::action

    REG_FORM --> VALID_REG{"Validaciones:<br/>email único ≤254<br/>pass ≥8 chars<br/>confirm_pass coincide"}
    VALID_REG -->|Fallan| REG_ERROR["Error amigable<br/>?error=email_invalido<br/>?error=password_no_coinciden"]:::action
    VALID_REG -->|OK| REG_OK["Crear usuario + hash pass<br/>SET rol=cliente<br/>Iniciar sesión"]:::action
    REG_OK --> REDIR_HOME["Redirigir a /?register=success"]:::action

    LOGIN_FORM --> CHECK_CRED{"check_password_hash<br/>+ bloqueo 5 intentos/30s"}
    CHECK_CRED -->|Fallan| LOGIN_ERROR["Error credenciales<br/>?intentos=N / bloqueado"]:::action
    CHECK_CRED -->|OK| SET_SESSION["Crear sesión:<br/>logueado=true<br/>usuario_id, nombre<br/>admin=(rol==admin)"]:::action
    SET_SESSION --> REDIR_NEXT{"¿Parámetro next?"}
    REDIR_NEXT -->|"Sí + interno"| REDIR_NEXT_URL["Redirigir a next<br/>/admin, /pago, /mis-pedidos..."]:::action
    REDIR_NEXT -->|No| REDIR_HOME

    %% ===== CARRITO (localStorage) =====
    CARRITO_ADD["Agregar al carrito<br/>localStorage: apomat_carrito"]:::action
    CARRITO_ADD --> CARRITO_VIEW[/"Ver Carrito / Offcanvas lateral"/]:::page
    CARRITO_VIEW --> CHECKOUT_BTN["Ir a Pago"]:::action

    %% ===== CHECKOUT / PAGO =====
    CHECKOUT_BTN --> PAGO_PAGE[/"Checkout / pago.html"/]:::page
    PAGO_PAGE --> STEP1{"¿Datos completos?"}
    STEP1 -->|No| STEP1_FIX["Completar: nombre, email,<br/>teléfono, dirección"]:::action
    STEP1 -->|Sí| STEP2["Paso 2: Método de pago<br/>Stripe Elements"]:::page
    STEP2 --> STRIPE_API["POST /api/pago<br/>{items, nombre, email, tel, dir}"]:::api
    STRIPE_API --> PI_CREATE["Stripe: PaymentIntent<br/>amount ×100 COP"]:::api
    PI_CREATE --> DB_PEDIDO["INSERT pedido + detalle_pedido<br/>UPDATE stock - cantidad"]:::db
    DB_PEDIDO --> PEDIDO_OK{"¿Éxito?"}
    PEDIDO_OK -->|Sí| SUCCESS[/"Pedido Exitoso / pedido-exitoso.html"/]:::page
    PEDIDO_OK -->|No| FAIL[/"Pedido Fallido / pedido-fallido.html"/]:::page
    SUCCESS --> CLEAR_CART["Limpiar localStorage carrito"]:::action
    FAIL --> KEEP_CART["Mantener carrito para reintentar"]:::action

    %% ===== MIS PEDIDOS =====
    MIS_PEDIDOS[/"Mis Pedidos / mis-pedidos.html + fetch /api/mis-pedidos"/]:::page
    MIS_PEDIDOS --> PEDIDO_DETALLE["Ver detalle pedido con items"]:::page

    %% ===== ADMIN =====
    ADMIN_LOGIN["Login admin<br/>apomat@gmail.com"]:::admin
    ADMIN_LOGIN --> ADMIN_DASH[/"Panel Admin / admin.html + fetch /admin/api/*"/]:::admin
    ADMIN_DASH --> ADMIN_PRODUCTOS[/"Gestión Productos / CRUD"/]:::admin
    ADMIN_DASH --> ADMIN_PEDIDOS[/"Gestión Pedidos / Estados"/]:::admin

    ADMIN_PRODUCTOS --> PROD_CREATE["Crear: POST /admin/productos/agregar<br/>+ imagen → web/img/"]:::admin
    ADMIN_PRODUCTOS --> PROD_EDIT["Editar: POST /admin/productos/editar/id<br/>precio, rebaja, stock, categoría"]:::admin
    ADMIN_PRODUCTOS --> PROD_DELETE["Eliminar: POST /admin/productos/eliminar/id"]:::admin

    ADMIN_PEDIDOS --> ORDER_STATUS["Cambiar estado: pendiente→enviado→entregado<br/>POST /admin/pedidos/estado/id"]:::admin

    %% ===== API ENDPOINTS CLAVE =====
    API_PRODUCTOS["/api/productos / /api/producto/:id"]:::api
    API_PAGO["/api/pago POST"]:::api
    API_MIS_PEDIDOS["/api/mis-pedidos"]:::api
    API_ADMIN_DASH["/admin/api/dashboard"]:::api
    API_ADMIN_PROD["/admin/api/productos"]:::api
    API_ADMIN_ORDERS["/admin/api/pedidos"]:::api

    %% ===== BD =====
    DB[("MySQL: jeiner_db<br/>usuario, producto, pedido,<br/>detalle_pedido, contacto")]:::db

    REG_OK --> DB
    SET_SESSION --> DB
    DB_PEDIDO --> DB
    PROD_CREATE --> DB
    PROD_EDIT --> DB
    PROD_DELETE --> DB
    ORDER_STATUS --> DB
    API_PRODUCTOS --> DB
    API_MIS_PEDIDOS --> DB
    API_ADMIN_DASH --> DB
    API_ADMIN_PROD --> DB
    API_ADMIN_ORDERS --> DB

    %% ===== SEGURIDAD =====
    SEC_OPEN_REDIR["Validación next:<br/>bloquea http://, //, javascript:"]:::action
    SEC_SQL["Errores MySQL → genéricos<br/>(no expone tracebacks)"]:::action
    SEC_ROL["Middleware: /admin*<br/>requiere session.admin=true"]:::action
    SEC_HTTPONLY["Cookies HttpOnly<br/>SameSite=Lax"]:::action

    REDIR_NEXT --> SEC_OPEN_REDIR
    DB_PEDIDO --> SEC_SQL
    ADMIN_DASH --> SEC_ROL
    SET_SESSION --> SEC_HTTPONLY

    %% ===== SALIDAS =====
    LOGOUT["Logout: GET /logout<br/>Destruir sesión"]:::action
    LOGOUT --> HOME

    MIS_PEDIDOS -.->|"requiere login"| LOGIN
    PAGO_PAGE -.->|"requiere login"| LOGIN
    ADMIN_DASH -.->|"requiere admin"| LOGIN

    %% ===== LEYENDA =====
    LEGEND_PAGES["Páginas HTML"]:::page
    LEGEND_ACTIONS["Acciones/Procesos"]:::action
    LEGEND_DECISIONS["Decisiones"]:::decision
    LEGEND_APIS["APIs JSON"]:::api
    LEGEND_ADMIN["Admin"]:::admin
    LEGEND_DB["Base de Datos"]:::db